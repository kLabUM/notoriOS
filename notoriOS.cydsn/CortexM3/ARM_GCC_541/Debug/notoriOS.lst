 237:notoriOS.c    **** // I never sleep, 'cause sleep is the cousin of death
 238:notoriOS.c    **** //      - NAS (1994)
 239:notoriOS.c    **** //
 240:notoriOS.c    **** // This is the scheduler. It's called from various interrupts and timers,
 241:notoriOS.c    **** // ...in particular from fuctions with in the real-tiem clock interrupts (RTC_INT.c)
 242:notoriOS.c    **** // It will add tasks to the work queue,
 243:notoriOS.c    **** // which will be executed eventually by WorkWorkWorkWorkWorkWork()
 244:notoriOS.c    **** // ==============================================
